{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  "include": [
    "index.ts",
    "cli/**/*.ts",
    "drizzle/**/*.ts",
    "email/**/*.ts",
    "oauth/**/*.ts",
    "script/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests", "tsup.config.ts", "vitest.config.ts"]
}
